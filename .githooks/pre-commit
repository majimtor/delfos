#!/bin/sh
# Blocks a commit whose staged changes contain a secret.
# Activate once per clone: git config core.hooksPath .githooks
set -eu

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not on PATH; install it from https://github.com/gitleaks/gitleaks/releases" >&2
  exit 1
fi

exec gitleaks git --pre-commit --staged --redact --no-banner --exit-code 1
