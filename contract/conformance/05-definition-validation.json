{
  "suite": "definition-validation",
  "description": "Validation of a draft definition. Every error is reported at once. Mode \"save\" applies to saving a draft; mode \"publish\" adds the checks of publication.",
  "cases": [
    {
      "name": "a valid definition has no errors",
      "mode": "publish",
      "definition": {
        "questions": [
          {
            "key": "q1",
            "type": "SINGLE_CHOICE",
            "text": "Do you own a car?",
            "required": true,
            "options": [
              {
                "key": "yes",
                "label": "Yes"
              },
              {
                "key": "no",
                "label": "No"
              }
            ]
          },
          {
            "key": "q2",
            "type": "SINGLE_CHOICE",
            "text": "Which fuel does it use?",
            "required": false,
            "options": [
              {
                "key": "petrol",
                "label": "Petrol"
              },
              {
                "key": "diesel",
                "label": "Diesel"
              },
              {
                "key": "electric",
                "label": "Electric"
              }
            ]
          },
          {
            "key": "q3",
            "type": "NUMBER",
            "text": "How many kilometres a year?",
            "required": false,
            "min": 0,
            "max": 200000,
            "integerOnly": true
          },
          {
            "key": "q4",
            "type": "TEXT",
            "text": "Why not?",
            "required": false,
            "maxLength": 200
          },
          {
            "key": "q5",
            "type": "SCALE",
            "text": "How satisfied are you with public transport?",
            "required": true,
            "min": 1,
            "max": 5,
            "minLabel": "Not at all",
            "maxLabel": "Very"
          },
          {
            "key": "q6",
            "type": "TEXT",
            "text": "Any comment on charging?",
            "required": false,
            "maxLength": 300
          },
          {
            "key": "q7",
            "type": "TEXT",
            "text": "Any other comment about your car situation?",
            "required": false,
            "maxLength": 300
          },
          {
            "key": "q8",
            "type": "TEXT",
            "text": "Why did you skip the first question?",
            "required": false,
            "maxLength": 300
          }
        ],
        "rules": [
          {
            "targetQuestionKey": "q2",
            "match": "ALL",
            "conditions": [
              {
                "sourceQuestionKey": "q1",
                "operator": "EQUALS",
                "value": {
                  "optionKey": "yes"
                }
              }
            ]
          },
          {
            "targetQuestionKey": "q3",
            "match": "ALL",
            "conditions": [
              {
                "sourceQuestionKey": "q1",
                "operator": "EQUALS",
                "value": {
                  "optionKey": "yes"
                }
              }
            ]
          },
          {
            "targetQuestionKey": "q4",
            "match": "ALL",
            "conditions": [
              {
                "sourceQuestionKey": "q1",
                "operator": "EQUALS",
                "value": {
                  "optionKey": "no"
                }
              }
            ]
          },
          {
            "targetQuestionKey": "q6",
            "match": "ALL",
            "conditions": [
              {
                "sourceQuestionKey": "q2",
                "operator": "EQUALS",
                "value": {
                  "optionKey": "electric"
                }
              },
              {
                "sourceQuestionKey": "q3",
                "operator": "GTE",
                "value": {
                  "number": 10000
                }
              }
            ]
          },
          {
            "targetQuestionKey": "q7",
            "match": "ANY",
            "conditions": [
              {
                "sourceQuestionKey": "q2",
                "operator": "IS_ANSWERED"
              },
              {
                "sourceQuestionKey": "q4",
                "operator": "IS_ANSWERED"
              }
            ]
          },
          {
            "targetQuestionKey": "q8",
            "match": "ALL",
            "conditions": [
              {
                "sourceQuestionKey": "q1",
                "operator": "IS_NOT_ANSWERED"
              }
            ]
          }
        ]
      },
      "expectedErrors": []
    },
    {
      "name": "an empty draft can be saved but not published",
      "mode": "publish",
      "definition": {
        "questions": [],
        "rules": []
      },
      "expectedErrors": [
        {
          "path": "questions",
          "code": "NO_QUESTIONS"
        }
      ]
    },
    {
      "name": "an empty draft can be saved",
      "mode": "save",
      "definition": {
        "questions": [],
        "rules": []
      },
      "expectedErrors": []
    },
    {
      "name": "a rule without conditions",
      "definition": {
        "questions": [
          {
            "key": "a",
            "type": "TEXT",
            "text": "A",
            "required": false
          },
          {
            "key": "b",
            "type": "TEXT",
            "text": "B",
            "required": false
          }
        ],
        "rules": [
          {
            "targetQuestionKey": "b",
            "match": "ALL",
            "conditions": []
          }
        ]
      },
      "expectedErrors": [
        {
          "path": "rules[0].conditions",
          "code": "EMPTY_CONDITIONS"
        }
      ]
    },
    {
      "name": "unknown target and unknown source",
      "definition": {
        "questions": [
          {
            "key": "a",
            "type": "TEXT",
            "text": "A",
            "required": false
          },
          {
            "key": "b",
            "type": "TEXT",
            "text": "B",
            "required": false
          }
        ],
        "rules": [
          {
            "targetQuestionKey": "zz",
            "match": "ALL",
            "conditions": [
              {
                "sourceQuestionKey": "a",
                "operator": "IS_ANSWERED"
              }
            ]
          },
          {
            "targetQuestionKey": "b",
            "match": "ALL",
            "conditions": [
              {
                "sourceQuestionKey": "yy",
                "operator": "IS_ANSWERED"
              }
            ]
          }
        ]
      },
      "expectedErrors": [
        {
          "path": "rules[0].targetQuestionKey",
          "code": "UNKNOWN_QUESTION"
        },
        {
          "path": "rules[1].conditions[0].sourceQuestionKey",
          "code": "UNKNOWN_QUESTION"
        }
      ]
    },
    {
      "name": "a rule that references its own target",
      "definition": {
        "questions": [
          {
            "key": "a",
            "type": "TEXT",
            "text": "A",
            "required": false
