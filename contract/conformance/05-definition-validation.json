            "sourcePosition": 3,
            "targetPosition": 1
          }
        }
      ]
    },
    {
      "name": "operators that do not apply to the source type",
      "definition": {
        "questions": [
          {
            "key": "s",
            "type": "SINGLE_CHOICE",
            "text": "S",
            "required": false,
            "options": [
              {
                "key": "x",
                "label": "X"
              },
              {
                "key": "y",
                "label": "Y"
              }
            ]
          },
          {
            "key": "m",
            "type": "MULTIPLE_CHOICE",
            "text": "M",
            "required": false,
            "options": [
              {
                "key": "x",
                "label": "X"
              },
              {
                "key": "y",
                "label": "Y"
              }
            ]
          },
          {
            "key": "t",
            "type": "TEXT",
            "text": "T",
            "required": false
