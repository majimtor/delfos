        "rules": [
          {
            "targetQuestionKey": "z",
            "match": "ANY",
            "conditions": [
              {
                "sourceQuestionKey": "s",
                "operator": "GT",
                "value": {
                  "number": 1
                }
              },
              {
                "sourceQuestionKey": "s",
                "operator": "INCLUDES_ANY",
                "value": {
                  "optionKeys": [
                    "x"
                  ]
                }
              },
              {
                "sourceQuestionKey": "m",
                "operator": "EQUALS",
                "value": {
                  "optionKey": "x"
                }
              },
              {
                "sourceQuestionKey": "t",
                "operator": "EQ",
                "value": {
                  "number": 1
                }
              }
