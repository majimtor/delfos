{
  "name": "delfos-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run generate:api && vite",
    "build": "npm run generate:api && tsc -b && vite build",
    "preview": "vite preview",
    "e2e": "playwright test",
    "media": "playwright test --config playwright.media.config.ts",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:api": "openapi-typescript ../contract/openapi.yaml --output src/api/schema.d.ts",
    "i18n:extract": "formatjs extract 'src/**/*.{ts,tsx}' --out-file build/messages.json --format simple",
    "i18n:check": "npm run i18n:extract && node scripts/check-i18n.mjs",
    "test": "npm run generate:api && vitest run",
    "check": "npm run lint && npm run format:check && npm run i18n:check && npm run test && npm run build && node scripts/check-bundle.mjs",
    "i18n:sync-en": "formatjs extract 'src/**/*.{ts,tsx}' --out-file src/i18n/en.json --format simple"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "@tanstack/react-query": "5.107.2",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-intl": "12.1.7",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@formatjs/cli": "6.19.0",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "openapi-typescript": "7.13.0",
    "oxlint": "1.94.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "wrangler": "4.164.0"
  },
  "engines": {
    "node": ">=26"
  }
}
