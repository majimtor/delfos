# Response headers of the web, applied by the Worker that serves these files as static assets.
# The API sends its own; the web gets the same protections here, plus a content security policy:
# scripts only from this origin (the language script is a file for that reason), styles also
# inline because the component library injects them, connections only to the API.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.delfos.manuelalejandro.com; manifest-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'

# Built files carry a hash in their name, so a browser may keep them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
