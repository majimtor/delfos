# Copy this file to .env next to compose.yaml and fill it in; compose passes every value on.

# The address Caddy serves. A domain whose name points at this machine gets a certificate by
# itself; ":80" serves plain HTTP on port 80, for a try on the machine itself.
DELFOS_SITE_ADDRESS=delfos.example.org

# The version to run, as the releases page names it; "latest" moves with every release, so pin a
# version once the instance is in use.
DELFOS_VERSION=latest

# The password of the database, chosen once; it stays inside the machine.
DELFOS_DB_PASSWORD=choose-a-long-random-value

# The first administrator, created at the first start only, while the instance has no account:
# 3 to 64 lowercase letters, digits, dots, hyphens or underscores, and 12 to 256 characters.
DELFOS_ADMIN_USERNAME=admin
DELFOS_ADMIN_PASSWORD=choose-twelve-characters-or-more
